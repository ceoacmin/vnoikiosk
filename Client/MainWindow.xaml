<Window x:Class="VnoiKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VNOI SEB Kiosk" Height="1080" Width="1920"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Topmost="True"
        Background="#050811" FontFamily="Segoe UI">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,-20" To="0,0,0,0" Duration="0:0:0.4">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PopupFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style TargetType="TextBox" x:Key="VisibleGlassTextBox">
            <Setter Property="Background" Value="#0A1128"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="EpicJoinButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" BorderThickness="2" BorderBrush="#38BDF8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0.0"/>
                                    <GradientStop Color="#2563EB" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#30FFFFFF" Opacity="0" CornerRadius="8"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#40000000"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="EpicDangerButton" BasedOn="{StaticResource EpicJoinButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" BorderThickness="2" BorderBrush="#F43F5E">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E11D48" Offset="0.0"/>
                                    <GradientStop Color="#9F1239" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F43F5E" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#30FFFFFF" Opacity="0" CornerRadius="8"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Panel.ZIndex="0">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.0" RadiusX="1.4" RadiusY="1.4">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#050811" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <wv2:WebView2 x:Name="VnoiBrowser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="1" Visibility="Collapsed"/>
        <wv2:WebView2 x:Name="WebrtcView" Visibility="Collapsed" Width="0" Height="0"/>

        <Grid x:Name="Page1_Dashboard" Panel.ZIndex="2" Visibility="Visible">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.0" RadiusX="1.4" RadiusY="1.4">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#050811" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid x:Name="LoginView" Visibility="Visible">
                <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#0B1120" CornerRadius="20" BorderBrush="#1E293B" BorderThickness="2">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="80" ShadowDepth="20" Opacity="0.8"/></Border.Effect>
                    <StackPanel Margin="50,45,50,45">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#1E3A8A" Margin="0,0,0,20">
                            <Border.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                            <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        </Border>
                        
                        <TextBlock Text="HỆ THỐNG THI VNOI" FontSize="26" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Cổng xác thực Kiosk an toàn tuyệt đối" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <TextBlock Text="Tài khoản VNOI" Foreground="#CBD5E1" FontSize="14" Margin="0,0,0,8" FontWeight="Bold"/>
                        <TextBox x:Name="UsernameInput" Style="{StaticResource VisibleGlassTextBox}" Height="55" Margin="0,0,0,15" />

                        <TextBlock Text="Mật khẩu" Foreground="#CBD5E1" FontSize="14" Margin="0,0,0,8" FontWeight="Bold"/>
                        <Grid Margin="0,0,0,15" Height="55">
                            <PasswordBox x:Name="PasswordInputHidden" Background="#0A1128" Foreground="#F8FAFC" BorderBrush="#1E293B" BorderThickness="2" Padding="15,14" FontSize="15" FontFamily="Consolas" Visibility="Visible"/>
                            <TextBox x:Name="PasswordInputVisible" Background="#0A1128" Foreground="#F8FAFC" BorderBrush="#1E293B" BorderThickness="2" Padding="15,14" FontSize="15" FontFamily="Consolas" Visibility="Collapsed"/>
                            <Button x:Name="BtnToggleEye" Content="👁️" Width="45" Height="45" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5" Background="Transparent" BorderThickness="0" FontSize="18" Cursor="Hand" Click="BtnToggleEye_Click" FocusVisualStyle="{x:Null}"/>
                        </Grid>

                        <TextBlock Text="Mã Truy Cập Kiosk" Foreground="#CBD5E1" FontSize="14" Margin="0,0,0,8" FontWeight="Bold"/>
                        <TextBox x:Name="AccessKeyInput" Style="{StaticResource VisibleGlassTextBox}" Height="55" Margin="0,0,0,25" />

                        <TextBlock x:Name="lblStatus" Text="" Foreground="#EF4444" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <Button x:Name="BtnProceedToContests" Content="XÁC THỰC VÀ KẾT NỐI" Style="{StaticResource EpicJoinButton}" Height="60" Click="BtnProceedToContests_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ContestView" Visibility="Hidden" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0B1120" Padding="50,30,120,30" BorderBrush="#1E293B" BorderThickness="0,0,0,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KỲ THI TRỰC TUYẾN" FontSize="26" FontWeight="Black" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <Border Background="#059669" CornerRadius="10" Padding="14,6" Margin="25,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ĐANG DIỄN RA" Foreground="White" FontSize="12" FontWeight="Black"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#1E3A8A" Margin="0,0,15,0">
                                <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Giám sát bởi hệ thống" Foreground="#64748B" FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtCurrentUser" Text="User" Foreground="#38BDF8" FontSize="18" FontWeight="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="40" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="ContestListPanel" Orientation="Horizontal" ItemWidth="440" ItemHeight="260" HorizontalAlignment="Center">
                        <Border Background="#0B1120" CornerRadius="20" Margin="20" Padding="35" BorderBrush="#1E293B" BorderThickness="2">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.6"/></Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="lblExamTitle" Grid.Row="0" Text="Đang tải dữ liệu bài thi..." FontSize="24" FontWeight="Black" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Môi trường thi sẽ bị khóa hoàn toàn. Nghiêm cấm thoát trình duyệt." Foreground="#94A3B8" FontSize="15" Margin="0,15,0,0" TextWrapping="Wrap" LineHeight="22"/>
                                <Border Grid.Row="2" Height="1.5" Background="#1E293B" Margin="0,25,0,25"/> 
                                <Button Grid.Row="3" x:Name="BtnSelectContest1" Content="BẮT ĐẦU LÀM BÀI" Height="55" Style="{StaticResource EpicJoinButton}" Click="BtnSelectContest_Click"/>
                            </Grid>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <Button x:Name="BtnAbout" Content="ℹ CTNS Development" Width="180" Height="45" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30"
                    Background="#0F172A" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold" BorderBrush="#1E293B" BorderThickness="1.5"
                    Cursor="Hand" FocusVisualStyle="{x:Null}" Click="BtnAbout_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Grid x:Name="ConfirmPopup" Visibility="Hidden">
                <Border Background="#E6000000"/>
                <Border Width="500" Height="280" Background="#0B1120" CornerRadius="20" BorderBrush="#38BDF8" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="50" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Text="KHÓA MÔI TRƯỜNG THI" FontSize="24" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="Bạn sẽ không thể thoát cho đến khi nộp bài." Foreground="#94A3B8" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                            <Button x:Name="BtnConfirmYes" Content="ĐỒNG Ý THAM GIA" Width="190" Height="50" Style="{StaticResource EpicJoinButton}" Click="BtnConfirmYes_Click" Margin="0,0,25,0"/>
                            <Button x:Name="BtnConfirmNo" Content="HỦY BỎ" Width="190" Height="50" Style="{StaticResource EpicDangerButton}" Click="BtnConfirmNo_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            
            <Grid x:Name="ErrorPopup" Visibility="Hidden">
                <Border Background="#F2000000"/>
                <Border Width="520" Height="300" Background="#0B1120" CornerRadius="20" BorderBrush="#F43F5E" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TỪ CHỐI TRUY CẬP" Foreground="#F43F5E" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock x:Name="lblErrorMsg" Grid.Row="1" Text="Thông tin không hợp lệ." Foreground="#CBD5E1" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" x:Name="BtnErrorAcknowledge" Content="THỬ LẠI" Width="200" Height="55" Style="{StaticResource EpicDangerButton}" HorizontalAlignment="Center" Click="BtnErrorAcknowledge_Click" Margin="0,25,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="Page2_Loading" Panel.ZIndex="3" Visibility="Hidden">
            <Border Background="#FA050811"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="80" Height="80" BorderBrush="#1E293B" BorderThickness="6" CornerRadius="40" Margin="0,0,0,30" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform x:Name="SpinnerTransform"/></Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Border Width="20" Height="20" Background="#38BDF8" CornerRadius="10" VerticalAlignment="Top" Margin="0,-10,0,0">
                        <Border.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="15" ShadowDepth="0" Opacity="1"/></Border.Effect>
                    </Border>
                </Border>
                <TextBlock x:Name="LoadingText" Text="Đang khởi động kỳ thi..." Foreground="#38BDF8" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Page4_ExitScreen" Panel.ZIndex="4" Visibility="Hidden">
            <Border Background="#FA050811"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="ĐÃ THOÁT KHỎI KỲ THI" Foreground="#F43F5E" FontSize="45" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#F43F5E" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Hệ thống giám sát đã ghi nhận bài làm của bạn." Foreground="#F8FAFC" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Nếu bạn muốn tham gia lại, vui lòng tắt và mở lại phần mềm.&#x0a;Click vào dấu '✖' ở góc trên cùng bên phải để thoát ứng dụng." Foreground="#94A3B8" FontSize="18" TextAlignment="Center" HorizontalAlignment="Center" LineHeight="28"/>
            </StackPanel>
        </Grid>

        <Button x:Name="BtnEmergencyExit" Content="✖" Width="55" Height="55" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="30"
                Background="#1AFFFFFF" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" BorderThickness="0"
                Cursor="Hand" FocusVisualStyle="{x:Null}" Click="BtnEmergencyExit_Click" Panel.ZIndex="9999">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="27.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E11D48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>